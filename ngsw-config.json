{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/index.html", "/favicon.ico", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/favicon/**",
          "/assets/fonts/**",
          "/assets/img/*.webp",
          "/assets/img/svg/**",
          "/media/**"
        ]
      }
    }
  ]
}
